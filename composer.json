{
    "name": "tobento/app-search",
    "version": "2.0",
    "type": "library",
    "description": "App search support.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "search"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-language": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-translation": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/css-modal": "^1.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-pagination": "^2.0",
        "tobento/service-menu": "^2.0",
        "tobento/service-repository": "^2.0",
        "tobento/service-support": "^2.0",
        "tobento/service-view": "^2.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-database": "^2.0",
        "tobento/app-testing": "^2.0",
        "tobento/service-container": "^2.0",
        "tobento/service-repository-storage": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Search\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Search\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}